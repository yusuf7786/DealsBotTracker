# ─────────────────────────────────────────────────────────────────────────
# DealsBotTracker — environment configuration
# Copy this file to .env and fill in the values. See README.md "Installation"
# for exactly what each key is, where to get it, and why it's needed.
# ─────────────────────────────────────────────────────────────────────────

# --- REQUIRED ---

# PostgreSQL connection string. If you're using the provided docker-compose,
# leave this exactly as-is — it points at the "postgres" service.
DATABASE_URL="postgresql://dealbot:dealbot_local_dev_pw@localhost:5432/dealsbottracker?schema=public"

# Redis connection, used by the background scanner/notification queue. If
# you're using docker-compose, leave this as-is.
REDIS_URL="redis://localhost:6379"

# Random secret used to sign your login session. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-plus-character-string"

# Your login credentials for the app (this is a single-user personal app).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Base URL the app is served from (used to build links in notifications).
APP_URL="http://localhost:3000"

# --- CRON (only needed for serverless deployments with no always-on worker,
# e.g. Vercel free tier — see README "Free-tier hosting" section) ---
# Any long random string. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- DEMO MODE ---
# When true, the scanner uses built-in realistic sample data instead of (or
# alongside) real retailer sources, so the app is fully usable immediately.
DEMO_MODE="true"

# --- OPTIONAL: NOTIFICATIONS (leave blank to disable a channel) ---

# Email (SMTP) — e.g. Gmail App Password, SendGrid, Mailgun SMTP, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DealsBotTracker <deals@example.com>"
NOTIFY_EMAIL_TO=""

# Telegram — message @BotFather to create a bot and get a token, then
# message your bot once and visit https://api.telegram.org/bot<token>/getUpdates
# to find your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Web Push (browser push notifications). Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# WhatsApp via Twilio (optional — requires a Twilio account with WhatsApp
# enabled). Leave blank to disable.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_TO=""

# --- OPTIONAL: AI DEAL EXPLANATIONS ---
# Without this, deal explanations use a deterministic rule-based template
# instead of an AI-generated sentence. Either way the deal score itself is
# always computed by the deterministic engine, never by AI.
ANTHROPIC_API_KEY=""

# --- OPTIONAL: REAL RETAILER SOURCES ---
# Tracked sources: Amazon ZA and Takealot. Until these are set, both run in
# clearly-labelled simulated mode. See src/lib/sources/retailers.ts.

# Amazon Product Advertising API (PA-API 5.0). Join the Amazon Associates
# programme at https://affiliate-program.amazon.co.za/ then request PA-API
# access from https://webservices.amazon.com/paapi5/documentation/ — all
# three of these are required together.
# NOTE: brand-new Associates accounts are typically rate-limited very
# aggressively by Amazon (sometimes ~1 request/hour) until the account has
# 3 qualifying sales within 180 days. That's an Amazon policy limit.
AMAZON_ZA_ACCESS_KEY=""
AMAZON_ZA_SECRET_KEY=""
AMAZON_ZA_PARTNER_TAG=""
# Only set these if requests fail with a host/region error — see
# https://webservices.amazon.com/paapi5/documentation/locale-reference.html
AMAZON_ZA_HOST=""
AMAZON_ZA_REGION=""
AMAZON_ZA_MARKETPLACE=""

# Takealot affiliate product feed URL — a CSV feed URL from Takealot's
# affiliate programme (commonly distributed via a network like Awin) once
# you're approved. The parser expects fairly standard column names
# (title/price/url/etc, see src/lib/sources/takealotFeed.ts) — if your real
# feed uses different headers, either rename them or adjust that file's
# COLUMN_ALIASES.
TAKEALOT_AFFILIATE_FEED_URL=""

# ─────────────────────────────────────────────────────────────────────────
# DealsBotTracker — environment configuration
# Copy this file to .env and fill in the values. See README.md "Installation"
# for exactly what each key is, where to get it, and why it's needed.
# ─────────────────────────────────────────────────────────────────────────

# --- REQUIRED ---

# PostgreSQL connection string. If you're using the provided docker-compose,
# leave this exactly as-is — it points at the "postgres" service.
DATABASE_URL="postgresql://dealbot:dealbot_local_dev_pw@localhost:5432/dealsbottracker?schema=public"

# Redis connection, used by the background scanner/notification queue. If
# you're using docker-compose, leave this as-is.
REDIS_URL="redis://localhost:6379"

# Random secret used to sign your login session. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-plus-character-string"

# Your login credentials for the app (this is a single-user personal app).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Base URL the app is served from (used to build links in notifications).
APP_URL="http://localhost:3000"

# --- DEMO MODE ---
# When true, the scanner uses built-in realistic sample data instead of (or
# alongside) real retailer sources, so the app is fully usable immediately.
DEMO_MODE="true"

# --- OPTIONAL: NOTIFICATIONS (leave blank to disable a channel) ---

# Email (SMTP) — e.g. Gmail App Password, SendGrid, Mailgun SMTP, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DealsBotTracker <deals@example.com>"
NOTIFY_EMAIL_TO=""

# Telegram — message @BotFather to create a bot and get a token, then
# message your bot once and visit https://api.telegram.org/bot<token>/getUpdates
# to find your chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Web Push (browser push notifications). Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# WhatsApp via Twilio (optional — requires a Twilio account with WhatsApp
# enabled). Leave blank to disable.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_TO=""

# --- OPTIONAL: AI DEAL EXPLANATIONS ---
# Without this, deal explanations use a deterministic rule-based template
# instead of an AI-generated sentence. Either way the deal score itself is
# always computed by the deterministic engine, never by AI.
ANTHROPIC_API_KEY=""

# --- OPTIONAL: REAL RETAILER SOURCE ---
# See src/lib/sources/exampleApiAdapter.ts for how to wire up a real,
# permitted retailer/marketplace API once you have credentials.
EXAMPLE_RETAILER_API_KEY=""

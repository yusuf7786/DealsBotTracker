generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH (single personal user)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCT CATALOG
// ─────────────────────────────────────────────────────────────────────────

/// Canonical product identity. Two listings only ever share a Product when
/// the matching engine's canonicalKey agrees on brand+model+variant+storage+
/// ram+colour+condition+region.
model Product {
  id             String   @id @default(cuid())
  canonicalKey   String   @unique
  brand          String
  manufacturer   String?
  productName    String
  modelNumber    String?
  variant        String?
  storage        String?
  ram            String?
  colour         String?
  condition      String   @default("new") // new | refurbished | used
  region         String   @default("ZA")
  category       String
  connectivity   String? // wifi | cellular | n/a
  simType        String? // single-sim | dual-sim | n/a
  imageUrl       String?
  currency       String   @default("ZAR")

  lowestKnownPrice  Decimal? @db.Decimal(12, 2)
  highestKnownPrice Decimal? @db.Decimal(12, 2)

  firstDiscoveredAt DateTime @default(now())
  lastCheckedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      Listing[]
  marketPrices  MarketPrice[]
  deals         Deal[]

  @@index([brand])
  @@index([category])
  @@index([productName])
  @@index([lastCheckedAt])
}

/// A single seller/source observation of a product.
model Listing {
  id       String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  source        String // adapter key, e.g. "demo-source-a"
  sourceLabel   String // human readable seller/source name
  seller        String
  sellerRating  Float? // 0-5
  url           String
  rawTitle      String

  currentPrice  Decimal  @db.Decimal(12, 2)
  previousPrice Decimal? @db.Decimal(12, 2)
  currency      String   @default("ZAR")
  shippingCost  Decimal? @db.Decimal(12, 2)

  condition       String  @default("new")
  warranty        String?
  availability    String  @default("in_stock") // in_stock | out_of_stock | preorder | unknown
  isMembershipOnly Boolean @default(false)
  isCouponRequired Boolean @default(false)
  isFinancingPrice Boolean @default(false)
  isBundle         Boolean @default(false)
  reliabilityWeight Float  @default(0.7) // 0-1, source trust weighting used by market price engine

  active        Boolean  @default(true)
  firstSeenAt   DateTime @default(now())
  lastCheckedAt DateTime @default(now())

  priceObservations PriceObservation[]
  bestForDeals       Deal[] @relation("BestListing")

  @@index([productId])
  @@index([source])
  @@index([currentPrice])
  @@index([lastCheckedAt])
  @@unique([productId, source, url])
}

/// Time-series of prices for a listing (for charts + history + lowest/highest).
model PriceObservation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(12, 2)
  observedAt DateTime @default(now())

  @@index([listingId, observedAt])
}

/// Computed market price snapshot for a product (recomputed only when prices
/// meaningfully change — see COST CONTROL requirement).
model MarketPrice {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  marketPrice  Decimal  @db.Decimal(12, 2)
  median       Decimal  @db.Decimal(12, 2)
  trimmedMean  Decimal  @db.Decimal(12, 2)
  stdDev       Decimal  @db.Decimal(12, 2)
  sourceCount  Int
  outliersRemoved Int   @default(0)
  method       String   @default("weighted-median-trimmed-mean")

  computedAt   DateTime @default(now())

  @@index([productId, computedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// DEALS
// ─────────────────────────────────────────────────────────────────────────

model Deal {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  bestListingId String
  bestListing   Listing @relation("BestListing", fields: [bestListingId], references: [id])

  currentPrice   Decimal @db.Decimal(12, 2)
  marketPrice    Decimal @db.Decimal(12, 2)
  savingsAmount  Decimal @db.Decimal(12, 2)
  savingsPercent Float

  dealScore  Int    // 0-100
  confidence Int    // 0-100
  tier       String // exceptional | excellent | good | none

  reasons        Json   // string[] — "why it's a deal"
  disqualifiers  Json   @default("[]") // string[] — false-deal-protection flags
  sourcesUsed    Int
  isNearAllTimeLow Boolean @default(false)

  status     String   @default("active") // active | expired | invalidated
  category   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastNotifiedAt DateTime?
  lastNotifiedPrice Decimal? @db.Decimal(12, 2)

  notifications NotificationLog[]

  @@index([status])
  @@index([tier])
  @@index([category])
  @@index([dealScore])
  @@index([createdAt])
  @@unique([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// WATCHLIST + ALERT RULES
// ─────────────────────────────────────────────────────────────────────────

model WatchlistItem {
  id               String   @id @default(cuid())
  type             String   // product | brand | category | keyword
  query            String   // free text: product name, brand, category, or keyword
  priceLimit       Decimal? @db.Decimal(12, 2)
  minDiscountPercent Float?
  minDealScore     Int?
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type])
}

model AlertRule {
  id         String   @id @default(cuid())
  name       String
  conditions Json     // { field, operator, value }[]
  channels   Json     // string[] e.g. ["email","telegram"]
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────

model NotificationLog {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  channel   String   // email | telegram | webpush | whatsapp
  status    String   // sent | failed | skipped
  message   String?
  error     String?
  sentAt    DateTime @default(now())

  @@index([channel])
  @@index([sentAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// SOURCES + SCANNER
// ─────────────────────────────────────────────────────────────────────────

model Source {
  id                  String   @id @default(cuid())
  key                 String   @unique // adapter key
  name                String
  type                String   @default("demo") // demo | api | feed
  enabled             Boolean  @default(true)
  priority            String   @default("normal") // high | normal | low
  scanFrequencyMinutes Int     @default(30)
  reliabilityWeight   Float    @default(0.7)
  requiresApiKey      Boolean  @default(false)
  apiKeyConfigured    Boolean  @default(false)
  lastScanAt          DateTime?
  nextScanAt          DateTime?
  status              String   @default("idle") // idle | scanning | error
  lastError           String?

  scanRuns ScanRun[]

  @@index([enabled])
}

model ScanRun {
  id                 String   @id @default(cuid())
  sourceId           String
  source             Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  status             String   @default("running") // running | success | partial | failed
  productsChecked    Int      @default(0)
  pricesDiscovered   Int      @default(0)
  dealsDetected      Int      @default(0)
  notificationsSent  Int      @default(0)
  errors             Json     @default("[]")

  @@index([sourceId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SETTINGS (singleton key/value store)
// ─────────────────────────────────────────────────────────────────────────

model Settings {
  id    String @id @default("singleton")
  value Json
  updatedAt DateTime @updatedAt
}
